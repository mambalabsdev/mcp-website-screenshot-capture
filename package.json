{
  "name": "@mambalabsdev/mcp-website-screenshot-capture",
  "version": "1.0.2",
  "description": "MCP server for Website Screenshot Capture. Screenshot a list of URLs as PNG or JPEG, full page or window, with the final URL, status, and title per page. Runs on Apify.",
  "type": "module",
  "bin": {
    "mcp-website-screenshot-capture": "./build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "screenshot",
    "website-screenshot",
    "web-capture",
    "full-page-screenshot",
    "url-to-image",
    "apify",
    "clay"
  ],
  "author": "Mamba Labs <labs@mambamindsetgrowth.com>",
  "license": "MIT",
  "homepage": "https://apify.com/mambalabs/website-screenshot-capture",
  "repository": {
    "type": "git",
    "url": "https://github.com/mambalabsdev/mcp-website-screenshot-capture"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "5.9.3"
  },
  "mcpName": "com.mambabuilt/mcp-website-screenshot-capture"
}
